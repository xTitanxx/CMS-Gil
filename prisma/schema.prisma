// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Auth (NextAuth.js required tables) ─────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id                   String                    @id @default(cuid())
  name                 String?
  email                String?                   @unique
  emailVerified        DateTime?
  image                String?
  passwordHash         String?
  // DB-side admin allowlist. ADMIN_EMAILS env var stays as a bootstrap
  // (always grants admin), but day-to-day adding/removing co-admins lives
  // here so it can be edited from the admin Settings UI without redeploying.
  isAdmin              Boolean                   @default(false)
  accounts             Account[]
  sessions             Session[]
  posts                Post[]
  importJobs           ImportJob[]
  platformTokens       PlatformToken[]
  driveSync            DriveSync?
  weeklyPlans          WeeklyPlan[]
  audioTracks          AudioTrack[]
  dailyBriefs          DailyBrief[]
  conversations        Conversation[]
  todos                Todo[]
  memories             UserMemory[]
  archiveUnderstanding UserArchiveUnderstanding?
  assistantUsage       AssistantUsage[]
  subscribersCreated   Subscriber[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Core Content ────────────────────────────────────────────────────────────

enum Lifecycle {
  UNKNOWN
  EVERGREEN
  EPHEMERAL
  SEASONAL
}

enum Season {
  SPRING
  SUMMER
  FALL
  WINTER
}

enum Readiness {
  UNCHECKED
  READY
  NOT_READY
  ARCHIVED
}

model Post {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  body           String
  bodyHtml       String?
  // Normalized lowercase copy of body, used for the posts-list search filter so
  // that typed keyboard text matches Facebook's smart-punctuation variants
  // (curly quotes, em-dashes, ellipsis, nbsp, zero-width). Written by all
  // Post-creating code paths via normalizeForSearch() in src/lib/search-normalize.ts.
  bodyNormalized String  @default("")
  // Link back to the original post on Facebook. For FB-imported posts this is
  // populated by backfill from the HTML export (the dyi/l/?l=<token> redirector
  // that FB bakes into its HTML export). See scripts/backfill-fb-urls.ts.
  platformUrl    String?

  source   PostSource @default(MANUAL)
  sourceId String?

  originalDate DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tags         String[] @default([])
  postType     PostType @default(POST)
  publishCount Int      @default(0)

  lifecycle           Lifecycle @default(UNKNOWN)
  season              Season?
  lifecycleOverridden Boolean   @default(false)
  readiness           Readiness @default(UNCHECKED)
  notReadyReasons     String[]  @default([])
  readinessCheckedAt  DateTime?
  archivedAt          DateTime?

  // Caption-only analysis (independent of media): does the caption itself
  // stand on its own as evergreen, and how much craft went into it?
  captionQuality    Int? // 1..5 (1 = low-effort, 5 = poetic/high-craft)
  captionEvergreen  Boolean? // true if the caption text is timeless on its own
  captionAnalyzedAt DateTime?
  // AI-generated rewrite for low-quality captions, using a few-shot corpus
  // of this user's own high-quality evergreen captions as style reference.
  // Only populated for posts flagged as low-quality or non-evergreen.
  captionSuggestion String?

  rating PostRating?

  // Populated when the imported post is a share/crosspost of another post or
  // external link. Shape: { url?: string; source?: string; name?: string }.
  // Null for original content. Lets the UI render a "shared from …" chip and
  // keeps the context that was otherwise dropped from the FB export.
  share Json?

  // Optional pointer to a "parent" multi-media post. Used when an FB album was
  // imported as a single 50-image post AND each individual photo also has its
  // own caption/location post in the export. The per-photo posts get linked
  // back to the album post so the UI can show a "Part of album" badge.
  // Backfilled by scripts/backfill-album-children.ts.
  parentPostId String?
  parentPost   Post?   @relation("PostAlbumChildren", fields: [parentPostId], references: [id], onDelete: SetNull)
  childPosts   Post[]  @relation("PostAlbumChildren")

  // Denormalized engagement counts. Updated in the same sequential-await chain
  // as the underlying mutation (no $transaction — pgbouncer gotcha).
  likeCount    Int @default(0)
  commentCount Int @default(0)

  media      Media[]
  publishes  PublishRecord[]
  analytics  PostAnalytics[]
  planSlots  WeeklyPlanSlot[]
  fbComments FacebookComment[]
  memories   UserMemory[]
  likes      PostLike[]
  bookmarks  PostBookmark[]
  comments   PostComment[]

  @@index([userId, originalDate])
  @@index([sourceId])
  @@index([parentPostId])
  @@index([tags], type: Gin)
  @@index([readiness])
  @@index([lifecycle])
}

model PostLike {
  id           String     @id @default(cuid())
  postId       String
  subscriberId String
  createdAt    DateTime   @default(now())

  post         Post       @relation(fields: [postId], references: [id], onDelete: Cascade)
  subscriber   Subscriber @relation(fields: [subscriberId], references: [id], onDelete: Cascade)

  @@unique([postId, subscriberId])
  @@index([subscriberId])
}

model PostBookmark {
  id           String     @id @default(cuid())
  postId       String
  subscriberId String
  createdAt    DateTime   @default(now())

  post         Post       @relation(fields: [postId], references: [id], onDelete: Cascade)
  subscriber   Subscriber @relation(fields: [subscriberId], references: [id], onDelete: Cascade)

  @@unique([postId, subscriberId])
  @@index([subscriberId, createdAt(sort: Desc)])
}

enum CommentStatus {
  PUBLISHED
  HIDDEN
}

model PostComment {
  id           String        @id @default(cuid())
  postId       String
  subscriberId String
  body         String
  status       CommentStatus @default(PUBLISHED)
  editedAt     DateTime?
  // Set when an admin hides the comment. Author hard-deletes do NOT set this —
  // they remove the row entirely. Soft delete preserves body for audit.
  deletedAt    DateTime?
  createdAt    DateTime      @default(now())

  post         Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  subscriber   Subscriber    @relation(fields: [subscriberId], references: [id], onDelete: Cascade)

  @@index([postId, status, createdAt])
  @@index([status, createdAt])
  @@index([subscriberId, createdAt])
}

enum PostSource {
  FACEBOOK
  MANUAL
}

enum PostType {
  POST
  REEL
  STORY
}

model Media {
  id     String @id @default(cuid())
  postId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  storageKey  String
  originalUri String?
  mimeType    String
  width       Int?
  height      Int?
  sizeBytes   Int?
  altText     String?

  // Whether the video media has an audio track. NULL = unknown / not checked yet
  // (also the resting state for image media, since the field is only meaningful
  // for videos). Populated by ffmpeg probe on new R2 uploads and by
  // scripts/backfill-audio.ts for historical rows.
  hasAudio Boolean?

  // Reference to an AudioTrack that should be muxed onto this (silent) video at
  // publish time — intended for adding licensed/custom music (e.g. generated in
  // Suno) to videos whose original audio was stripped by Facebook's licensed-
  // music policy during export. The publish-time mux is not yet implemented;
  // the relationship is preserved so the feature can be added later.
  audioTrackId String?
  audioTrack   AudioTrack? @relation(fields: [audioTrackId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
}

model AudioTrack {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title       String
  storageKey  String
  mimeType    String @default("audio/mpeg")
  sizeBytes   Int?
  durationSec Float?

  media Media[]

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

// ─── Social Platform Tokens ──────────────────────────────────────────────────

model PlatformToken {
  id       String   @id @default(cuid())
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform Platform

  accessToken  String
  refreshToken String?
  expiresAt    DateTime?

  platformUserId   String?
  platformUsername String?
  scopes           String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, platform])
}

enum Platform {
  FACEBOOK
  FACEBOOK_PAGE
  INSTAGRAM
  LINKEDIN
  YOUTUBE
  TIKTOK
}

// ─── Publishing ──────────────────────────────────────────────────────────────

model PublishRecord {
  id     String @id @default(cuid())
  postId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  platform Platform
  status   PublishStatus @default(PENDING)

  scheduledAt DateTime?
  publishedAt DateTime?

  platformPostId String?
  platformUrl    String?
  errorMessage   String?
  retryCount     Int     @default(0)

  analytics PublishAnalytics?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, scheduledAt])
  @@index([postId, platform])
}

// ─── Publish Analytics ──────────────────────────────────────────────────────

model PublishAnalytics {
  id              String        @id @default(cuid())
  publishRecord   PublishRecord @relation(fields: [publishRecordId], references: [id], onDelete: Cascade)
  publishRecordId String        @unique

  impressions Int?
  reach       Int?
  likes       Int?
  comments    Int?
  shares      Int?
  saves       Int? // Instagram only
  videoViews  Int? // video platforms

  fetchedAt DateTime @default(now())
  rawJson   Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum PublishStatus {
  PENDING
  PROCESSING
  PUBLISHED
  FAILED
  CANCELLED
}

// ─── Import Jobs ─────────────────────────────────────────────────────────────

model ImportJob {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  source   ImportSource @default(UPLOAD)
  filename String
  status   ImportStatus @default(PENDING)

  totalPosts    Int     @default(0)
  importedPosts Int     @default(0)
  skippedPosts  Int     @default(0)
  errorLog      String?

  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
}

model BulkAnalyzeJob {
  id        String            @id @default(cuid())
  userId    String
  status    BulkAnalyzeStatus @default(RUNNING)
  total     Int               @default(0)
  completed Int               @default(0)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@index([userId, status])
}

model BulkCaptionAnalyzeJob {
  id        String            @id @default(cuid())
  userId    String
  status    BulkAnalyzeStatus @default(RUNNING)
  total     Int               @default(0)
  completed Int               @default(0)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@index([userId, status])
}

enum BulkAnalyzeStatus {
  RUNNING
  CANCELLED
  DONE
}

enum ImportSource {
  UPLOAD
  GOOGLE_DRIVE
}

enum ImportStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

// ─── Google Drive Sync ───────────────────────────────────────────────────────

model DriveSync {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  folderId     String
  folderName   String
  enabled      Boolean   @default(true)
  lastSyncedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Analytics ───────────────────────────────────────────────────────────────

model PostAnalytics {
  id       String   @id @default(cuid())
  postId   String
  post     Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  platform Platform

  platformPostId String?
  reactions      Int?
  comments       Int?
  shares         Int?
  reach          Int?
  impressions    Int?

  fetchedAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([postId, platform])
  @@index([postId])
}

// ─── Facebook Comments (scraped) ────────────────────────────────────────────

model FacebookComment {
  id     String @id @default(cuid())
  postId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  authorName String
  body       String
  scrapedAt  DateTime @default(now())

  @@index([postId])
}

// ─── Weekly Planner ─────────────────────────────────────────────────────────

enum PlanStatus {
  DRAFT
  PARTIAL
  APPROVED
}

enum SlotStatus {
  PROPOSED
  APPROVED
  SCHEDULED
  SKIPPED
}

model WeeklyPlan {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  weekStart DateTime
  status    PlanStatus       @default(DRAFT)
  slots     WeeklyPlanSlot[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@unique([userId, weekStart])
}

model WeeklyPlanSlot {
  id        String     @id @default(cuid())
  planId    String
  plan      WeeklyPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  postId    String
  post      Post       @relation(fields: [postId], references: [id], onDelete: Cascade)
  day       DateTime
  // Optional hour-of-day (Asia/Jerusalem). When set, the schedule route uses
  // it directly; otherwise it falls back to FIXED_SLOT_HOURS by index in day.
  hour      Int?
  status    SlotStatus @default(PROPOSED)
  reasoning String?
  platforms String[]

  @@unique([planId, day, postId])
  @@index([planId, day])
  @@index([postId])
}

model PostRating {
  id        String   @id @default(cuid())
  postId    String   @unique
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  stars     Int
  reasons   String[] @default([])
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([stars])
}

model DailyBrief {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  payload   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, date])
}

model Conversation {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  messages  Message[]

  @@index([userId, updatedAt])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String
  content        Json
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}

model Todo {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  text      String
  done      Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, createdAt])
}

// Free-form memories the assistant can save about the user — preferences,
// post-feedback, abstracted patterns. Injected into the assistant's system
// prompt on every turn. `kind` is a coarse label for grouping/display only;
// the assistant decides what to write into `content`.
model UserMemory {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  content   String
  kind      String   @default("general") // "preference" | "post-feedback" | "general"
  postId    String?
  post      Post?    @relation(fields: [postId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, createdAt])
  @@index([postId])
}

model Subscriber {
  id               String                    @id @default(cuid())
  name             String
  email            String?
  codeHash         String                    @unique
  // HMAC-SHA256(code, SUBSCRIBER_INDEX_PEPPER), base64url. Lets sign-in look
  // up the row in O(1) instead of bcrypt-comparing every non-revoked row.
  // Nullable so rows created before this column existed keep working until
  // the user signs in once and the legacy fallback path backfills the index.
  codeBlindIndex   String?                   @unique
  monthlyBudgetUsd Decimal                   @default(1.20) @db.Decimal(8, 4)
  cycleStart       DateTime                  @default(now())
  cycleUsedUsd     Decimal                   @default(0) @db.Decimal(8, 4)
  createdAt        DateTime                  @default(now())
  lastSeenAt       DateTime?
  revokedAt        DateTime?
  // Public-facing display name shown on comments. Falls back to `name` when
  // null (the default — there is no longer a UI to pick one). Kept nullable
  // so admin tooling can still set a custom name per subscriber if needed.
  displayName        String?
  // Admin-set commenting disablement (without revoking the whole subscription).
  // When set, server rejects POST /comments with 403 { error: "comments_disabled" }.
  commentsDisabledAt DateTime?

  createdById      String
  createdBy        User                      @relation(fields: [createdById], references: [id])
  conversations    SubscriberConversation[]
  usageEvents      SubscriberUsage[]
  likes            PostLike[]
  bookmarks        PostBookmark[]
  comments         PostComment[]

  @@index([revokedAt])
}

model SubscriberConversation {
  id           String              @id @default(cuid())
  subscriberId String
  subscriber   Subscriber          @relation(fields: [subscriberId], references: [id], onDelete: Cascade)
  title        String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  messages     SubscriberMessage[]

  @@index([subscriberId, updatedAt])
}

model SubscriberMessage {
  id             String                 @id @default(cuid())
  conversationId String
  conversation   SubscriberConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String
  content        String
  createdAt      DateTime               @default(now())

  @@index([conversationId, createdAt])
}

model SubscriberUsage {
  id                       String     @id @default(cuid())
  subscriberId             String
  subscriber               Subscriber @relation(fields: [subscriberId], references: [id], onDelete: Cascade)
  inputTokens              Int
  cacheCreationInputTokens Int        @default(0)
  cacheReadInputTokens     Int        @default(0)
  outputTokens             Int
  costUsd                  Decimal    @db.Decimal(8, 6)
  createdAt                DateTime   @default(now())

  @@index([subscriberId, createdAt])
}

// Per-API-call usage + cost for the assistant. One row per Anthropic
// response (so multiple rows per user turn when tool-use iterates). Read by
// /api/assistant/usage to surface a running cost total in the UI.
model AssistantUsage {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversationId    String?
  model             String
  inputTokens       Int
  outputTokens      Int
  cacheCreateTokens Int      @default(0)
  cacheReadTokens   Int      @default(0)
  costUsd           Decimal  @db.Decimal(12, 6)
  createdAt         DateTime @default(now())

  @@index([userId, createdAt])
}

// Distilled "smart understanding" of a user's post archive — voice profile,
// thematic map, and a stratified sample of representative full-text posts.
// One row per user; refreshed weekly by /api/cron/archive-understanding.
// Read by buildSystemPrompt and pinned into the assistant's cached prompt.
model UserArchiveUnderstanding {
  userId           String   @id
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  voiceProfile     String   @db.Text
  thematicMap      String   @db.Text
  sampleBodies     Json // Array<{ id, originalDate, body, tags, theme }>
  generatedAt      DateTime @default(now())
  basedOnPostCount Int
  updatedAt        DateTime @updatedAt
}
