// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Auth (NextAuth.js required tables) ─────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id             String          @id @default(cuid())
  name           String?
  email          String?         @unique
  emailVerified  DateTime?
  image          String?
  passwordHash   String?
  accounts       Account[]
  sessions       Session[]
  posts          Post[]
  importJobs     ImportJob[]
  platformTokens PlatformToken[]
  driveSync      DriveSync?
  weeklyPlans    WeeklyPlan[]
  audioTracks    AudioTrack[]
  dailyBriefs    DailyBrief[]
  conversations  Conversation[]
  todos          Todo[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Core Content ────────────────────────────────────────────────────────────

enum Lifecycle {
  UNKNOWN
  EVERGREEN
  EPHEMERAL
  SEASONAL
}

enum Season {
  SPRING
  SUMMER
  FALL
  WINTER
}

enum Readiness {
  UNCHECKED
  READY
  NOT_READY
  ARCHIVED
}

model Post {
  id           String        @id @default(cuid())
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  body           String
  bodyHtml       String?
  // Normalized lowercase copy of body, used for the posts-list search filter so
  // that typed keyboard text matches Facebook's smart-punctuation variants
  // (curly quotes, em-dashes, ellipsis, nbsp, zero-width). Written by all
  // Post-creating code paths via normalizeForSearch() in src/lib/search-normalize.ts.
  bodyNormalized String  @default("")
  // Link back to the original post on Facebook. For FB-imported posts this is
  // populated by backfill from the HTML export (the dyi/l/?l=<token> redirector
  // that FB bakes into its HTML export). See scripts/backfill-fb-urls.ts.
  platformUrl    String?

  source       PostSource    @default(MANUAL)
  sourceId     String?

  originalDate DateTime
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  tags         String[]      @default([])
  postType     PostType      @default(POST)
  publishCount Int           @default(0)

  lifecycle           Lifecycle  @default(UNKNOWN)
  season              Season?
  lifecycleOverridden Boolean    @default(false)
  readiness           Readiness  @default(UNCHECKED)
  notReadyReasons     String[]   @default([])
  readinessCheckedAt  DateTime?
  archivedAt          DateTime?

  // Caption-only analysis (independent of media): does the caption itself
  // stand on its own as evergreen, and how much craft went into it?
  captionQuality      Int?       // 1..5 (1 = low-effort, 5 = poetic/high-craft)
  captionEvergreen    Boolean?   // true if the caption text is timeless on its own
  captionAnalyzedAt   DateTime?
  // AI-generated rewrite for low-quality captions, using a few-shot corpus
  // of this user's own high-quality evergreen captions as style reference.
  // Only populated for posts flagged as low-quality or non-evergreen.
  captionSuggestion   String?

  rating              PostRating?

  // Populated when the imported post is a share/crosspost of another post or
  // external link. Shape: { url?: string; source?: string; name?: string }.
  // Null for original content. Lets the UI render a "shared from …" chip and
  // keeps the context that was otherwise dropped from the FB export.
  share        Json?

  // Optional pointer to a "parent" multi-media post. Used when an FB album was
  // imported as a single 50-image post AND each individual photo also has its
  // own caption/location post in the export. The per-photo posts get linked
  // back to the album post so the UI can show a "Part of album" badge.
  // Backfilled by scripts/backfill-album-children.ts.
  parentPostId String?
  parentPost   Post?    @relation("PostAlbumChildren", fields: [parentPostId], references: [id], onDelete: SetNull)
  childPosts   Post[]   @relation("PostAlbumChildren")

  media        Media[]
  publishes    PublishRecord[]
  analytics    PostAnalytics[]
  planSlots    WeeklyPlanSlot[]

  @@index([userId, originalDate])
  @@index([sourceId])
  @@index([parentPostId])
  @@index([tags], type: Gin)
  @@index([readiness])
  @@index([lifecycle])
}

enum PostSource {
  FACEBOOK
  MANUAL
}

enum PostType {
  POST
  REEL
  STORY
}

model Media {
  id          String   @id @default(cuid())
  postId      String
  post        Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  storageKey  String
  originalUri String?
  mimeType    String
  width       Int?
  height      Int?
  sizeBytes   Int?
  altText     String?

  // Whether the video media has an audio track. NULL = unknown / not checked yet
  // (also the resting state for image media, since the field is only meaningful
  // for videos). Populated by the Cloudinary upload response on new uploads and
  // by scripts/backfill-audio.ts for historical rows.
  hasAudio    Boolean?

  // When set, indicates that the delivered video URL should be generated with a
  // Cloudinary audio overlay using the referenced AudioTrack's storageKey. Used
  // to add licensed/custom music (e.g. generated in Suno) to silent videos whose
  // original audio was stripped by Facebook's licensed-music policy during export.
  audioTrackId String?
  audioTrack   AudioTrack? @relation(fields: [audioTrackId], references: [id], onDelete: SetNull)

  createdAt   DateTime @default(now())
}

model AudioTrack {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  title       String
  storageKey  String
  mimeType    String   @default("audio/mpeg")
  sizeBytes   Int?
  durationSec Float?

  media       Media[]

  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
}

// ─── Social Platform Tokens ──────────────────────────────────────────────────

model PlatformToken {
  id               String    @id @default(cuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform         Platform

  accessToken      String
  refreshToken     String?
  expiresAt        DateTime?

  platformUserId   String?
  platformUsername String?
  scopes           String?

  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([userId, platform])
}

enum Platform {
  FACEBOOK
  FACEBOOK_PAGE
  INSTAGRAM
  LINKEDIN
  YOUTUBE
  TIKTOK
}

// ─── Publishing ──────────────────────────────────────────────────────────────

model PublishRecord {
  id             String        @id @default(cuid())
  postId         String
  post           Post          @relation(fields: [postId], references: [id], onDelete: Cascade)

  platform       Platform
  status         PublishStatus @default(PENDING)

  scheduledAt    DateTime?
  publishedAt    DateTime?

  platformPostId String?
  platformUrl    String?
  errorMessage   String?
  retryCount     Int           @default(0)

  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([status, scheduledAt])
  @@index([postId, platform])
}

enum PublishStatus {
  PENDING
  PROCESSING
  PUBLISHED
  FAILED
  CANCELLED
}

// ─── Import Jobs ─────────────────────────────────────────────────────────────

model ImportJob {
  id            String       @id @default(cuid())
  userId        String
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  source        ImportSource @default(UPLOAD)
  filename      String
  status        ImportStatus @default(PENDING)

  totalPosts    Int          @default(0)
  importedPosts Int          @default(0)
  skippedPosts  Int          @default(0)
  errorLog      String?

  startedAt     DateTime?
  completedAt   DateTime?
  createdAt     DateTime     @default(now())
}

model BulkAnalyzeJob {
  id          String             @id @default(cuid())
  userId      String
  status      BulkAnalyzeStatus  @default(RUNNING)
  total       Int                @default(0)
  completed   Int                @default(0)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([userId, status])
}

model BulkCaptionAnalyzeJob {
  id          String             @id @default(cuid())
  userId      String
  status      BulkAnalyzeStatus  @default(RUNNING)
  total       Int                @default(0)
  completed   Int                @default(0)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([userId, status])
}

enum BulkAnalyzeStatus {
  RUNNING
  CANCELLED
  DONE
}

enum ImportSource {
  UPLOAD
  GOOGLE_DRIVE
}

enum ImportStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

// ─── Google Drive Sync ───────────────────────────────────────────────────────

model DriveSync {
  id           String    @id @default(cuid())
  userId       String    @unique
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  folderId     String
  folderName   String
  enabled      Boolean   @default(true)
  lastSyncedAt DateTime?

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

// ─── Analytics ───────────────────────────────────────────────────────────────

model PostAnalytics {
  id             String   @id @default(cuid())
  postId         String
  post           Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  platform       Platform

  platformPostId String?
  reactions      Int?
  comments       Int?
  shares         Int?
  reach          Int?
  impressions    Int?

  fetchedAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([postId, platform])
  @@index([postId])
}

// ─── Weekly Planner ─────────────────────────────────────────────────────────

enum PlanStatus {
  DRAFT
  PARTIAL
  APPROVED
}

enum SlotStatus {
  PROPOSED
  APPROVED
  SCHEDULED
  SKIPPED
}

model WeeklyPlan {
  id        String     @id @default(cuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  weekStart DateTime
  status    PlanStatus @default(DRAFT)
  slots     WeeklyPlanSlot[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@unique([userId, weekStart])
}

model WeeklyPlanSlot {
  id        String     @id @default(cuid())
  planId    String
  plan      WeeklyPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  postId    String
  post      Post       @relation(fields: [postId], references: [id])
  day       DateTime
  status    SlotStatus @default(PROPOSED)
  reasoning String?
  platforms String[]

  @@unique([planId, day])
  @@index([postId])
}

model PostRating {
  id        String   @id @default(cuid())
  postId    String   @unique
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  stars     Int
  reasons   String[] @default([])
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([stars])
}

model DailyBrief {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  payload   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, date])
}

model Conversation {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  messages  Message[]

  @@index([userId, updatedAt])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String
  content        Json
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}

model Todo {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  text      String
  done      Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, createdAt])
}
