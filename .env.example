# ─── Database ────────────────────────────────────────────────────────────────
# PostgreSQL connection string (Neon, Supabase, Railway, etc.)
DATABASE_URL="postgresql://user:password@host:5432/cms_gil?sslmode=require"

# ─── NextAuth.js ─────────────────────────────────────────────────────────────
NEXTAUTH_SECRET="generate-with: openssl rand -hex 32"
NEXTAUTH_URL="https://your-app.vercel.app"

# ─── Google (YouTube + Drive) ────────────────────────────────────────────────
# Create at: https://console.cloud.google.com/
# Enable: YouTube Data API v3, Google Drive API
# Authorized redirect URIs: https://your-app.vercel.app/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ─── LinkedIn ────────────────────────────────────────────────────────────────
# Create at: https://www.linkedin.com/developers/apps
# Scopes: openid, profile, email, w_member_social, r_basicprofile
# Authorized redirect URI: https://your-app.vercel.app/api/auth/callback/linkedin
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""

# ─── Meta (Instagram) ────────────────────────────────────────────────────────
# Create at: https://developers.facebook.com/
# Add Instagram Graph API product
# Scopes: instagram_basic, instagram_content_publish
# Authorized redirect URI: https://your-app.vercel.app/api/connections/instagram/callback
META_APP_ID=""
META_APP_SECRET=""

# ─── TikTok ──────────────────────────────────────────────────────────────────
# Create at: https://developers.tiktok.com/
# Scopes: user.info.basic, video.publish, video.upload
# Authorized redirect URI: https://your-app.vercel.app/api/connections/tiktok/callback
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""

# ─── Storage (Cloudflare R2 or AWS S3) ───────────────────────────────────────
# For Cloudflare R2: endpoint = https://<account_id>.r2.cloudflarestorage.com
# For AWS S3: remove S3_ENDPOINT entirely
S3_BUCKET="cms-gil-media"
S3_REGION="auto"
S3_ENDPOINT="https://<account_id>.r2.cloudflarestorage.com"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# ─── Security ────────────────────────────────────────────────────────────────
# 32-byte hex key for AES-256 token encryption
# Generate: openssl rand -hex 32
ENCRYPTION_KEY=""

# Secret for Vercel Cron job authentication
# Generate: openssl rand -hex 32
CRON_SECRET=""
